      "model": "reasoningModelClient",
      "input": {
        "userQuery": "生成一份高质量的市场分析报告。先搜集最新市场数据，必须确保数据质量评分达到99分才算合格，否则自动修正数据直到达标。数据达标后，需要我确认是否继续生成报告。然后基于已达标的数据撰写报告初稿，报告质量评分必须达到85分才算合格，否则自动修正直到达标。每轮修正前都要我确认是否执行修正。最终报告达标后，需要我确认是否满意。"
      },
      "dependsOn": [],
      "mandatory": false,
      "timeoutMs": 0,
      "retry": 0,
      "includeChatHistory": false,
      "competitiveSelectorStepFlag": false,
      "iterativeCorrectionStepFlag": false
    },
